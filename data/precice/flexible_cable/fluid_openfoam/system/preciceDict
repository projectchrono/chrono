FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    location    "system";
    object      preciceDict;
}

preciceConfig   "../precice_config_openfoam.xml";

participant     Fluid;

modules         (FSI);

interfaces
{
    Interface1
    {
        mesh        FluidMesh;
        patches     (cable);
        locations   faceCenters;

        readData
        (
            Displacements
        );

        writeData
        (
            Forces
        );
    };
};

// interFoam provides the density field (rho), which the adapter uses in the force computation
FSI
{
    rho         rho [1 -3 0 0 0 0 0] 1000;
}

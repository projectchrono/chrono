FoamFile
{
    version     2.0;
    format      ascii;
    class       pointVectorField;
    location    "0";
    object      pointDisplacement;
}

dimensions      [0 1 0 0 0 0 0];

internalField   uniform (0 0 0);

boundaryField
{
    // Set by the preCICE adapter from the cable displacements
    cable
    {
        type            fixedValue;
        value           uniform (0 0 0);
    }
    // Mesh points may slide along the floor
    floor
    {
        type            slip;
    }
    // Mesh points are fixed on the top (sliding points at its edges conflict with the cyclic sides)
    top
    {
        type            fixedValue;
        value           uniform (0 0 0);
    }
    "(front|back|left|right)"
    {
        type            cyclic;
    }
}
